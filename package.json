{
  "name": "opencode-config-manager",
  "displayName": "OpenCode 配置管理器",
  "description": "管理 opencode / oh-my-opencode 配置：结构化修改、备份、恢复、命名预设一键切换",
  "version": "0.7.2",
  "publisher": "local",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "opencodeConfig",
          "title": "OpenCode 配置",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "opencodeConfig": [
        {
          "id": "opencodeModels",
          "name": "模型"
        },
        {
          "id": "opencodeConfigFiles",
          "name": "配置文件"
        },
        {
          "id": "opencodePresets",
          "name": "预设"
        },
        {
          "id": "opencodeBackups",
          "name": "备份"
        }
      ]
    },
    "commands": [
      {
        "command": "opencode.openConfigFile",
        "title": "打开配置文件",
        "category": "OpenCode"
      },
      {
        "command": "opencode.createConfig",
        "title": "创建缺失的配置文件",
        "category": "OpenCode"
      },
      {
        "command": "opencode.setAgentModel",
        "title": "设置 Agent/分类模型",
        "category": "OpenCode"
      },
      {
        "command": "opencode.capturePreset",
        "title": "从当前配置捕获预设",
        "category": "OpenCode",
        "icon": "$(add)"
      },
      {
        "command": "opencode.applyPreset",
        "title": "应用预设",
        "category": "OpenCode",
        "icon": "$(play)"
      },
      {
        "command": "opencode.editPreset",
        "title": "编辑预设（矩阵表单）",
        "category": "OpenCode",
        "icon": "$(edit)"
      },
      {
        "command": "opencode.renamePreset",
        "title": "重命名预设",
        "category": "OpenCode"
      },
      {
        "command": "opencode.deletePreset",
        "title": "删除预设",
        "category": "OpenCode"
      },
      {
        "command": "opencode.exportPreset",
        "title": "导出预设到文件",
        "category": "OpenCode"
      },
      {
        "command": "opencode.showPresetQuickPick",
        "title": "切换预设…",
        "category": "OpenCode"
      },
      {
        "command": "opencode.backupNow",
        "title": "立即备份",
        "category": "OpenCode",
        "icon": "$(save)"
      },
      {
        "command": "opencode.restoreBackup",
        "title": "恢复备份",
        "category": "OpenCode"
      },
      {
        "command": "opencode.diffBackup",
        "title": "与当前配置对比",
        "category": "OpenCode"
      },
      {
        "command": "opencode.deleteBackup",
        "title": "删除备份",
        "category": "OpenCode"
      },
      {
        "command": "opencode.refreshTree",
        "title": "刷新",
        "category": "OpenCode",
        "icon": "$(refresh)"
      },
      {
        "command": "opencode.addModel",
        "title": "添加模型…",
        "category": "OpenCode",
        "icon": "$(add)"
      },
      {
        "command": "opencode.deleteModel",
        "title": "删除模型",
        "category": "OpenCode"
      },
      {
        "command": "opencode.openModelsFile",
        "title": "打开模型清单文件",
        "category": "OpenCode",
        "icon": "$(go-to-file)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "opencode.refreshTree",
          "when": "view =~ /opencodeConfigFiles|opencodePresets|opencodeBackups/",
          "group": "navigation@99"
        },
        {
          "command": "opencode.capturePreset",
          "when": "view == opencodePresets",
          "group": "navigation@1"
        },
        {
          "command": "opencode.backupNow",
          "when": "view == opencodeBackups",
          "group": "navigation@1"
        },
        {
          "command": "opencode.addModel",
          "when": "view == opencodeModels",
          "group": "navigation@1"
        },
        {
          "command": "opencode.openModelsFile",
          "when": "view == opencodeModels",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "opencode.applyPreset",
          "when": "view == opencodePresets && viewItem == preset",
          "group": "inline@1"
        },
        {
          "command": "opencode.editPreset",
          "when": "view == opencodePresets && viewItem == preset",
          "group": "inline@2"
        },
        {
          "command": "opencode.renamePreset",
          "when": "view == opencodePresets && viewItem == preset"
        },
        {
          "command": "opencode.deletePreset",
          "when": "view == opencodePresets && viewItem == preset"
        },
        {
          "command": "opencode.exportPreset",
          "when": "view == opencodePresets && viewItem == preset"
        },
        {
          "command": "opencode.restoreBackup",
          "when": "view == opencodeBackups && viewItem == backup"
        },
        {
          "command": "opencode.diffBackup",
          "when": "view == opencodeBackups && viewItem == backup"
        },
        {
          "command": "opencode.deleteBackup",
          "when": "view == opencodeBackups && viewItem == backup"
        },
        {
          "command": "opencode.setAgentModel",
          "when": "view == opencodeConfigFiles && viewItem =~ /agent|category/"
        },
        {
          "command": "opencode.deleteModel",
          "when": "view == opencodeModels && viewItem == modelLocal"
        }
      ],
      "commandPalette": [
        {
          "command": "opencode.openConfigFile",
          "when": "false"
        },
        {
          "command": "opencode.setAgentModel",
          "when": "false"
        },
        {
          "command": "opencode.applyPreset",
          "when": "false"
        },
        {
          "command": "opencode.editPreset",
          "when": "false"
        },
        {
          "command": "opencode.renamePreset",
          "when": "false"
        },
        {
          "command": "opencode.deletePreset",
          "when": "false"
        },
        {
          "command": "opencode.exportPreset",
          "when": "false"
        },
        {
          "command": "opencode.restoreBackup",
          "when": "false"
        },
        {
          "command": "opencode.diffBackup",
          "when": "false"
        },
        {
          "command": "opencode.deleteBackup",
          "when": "false"
        },
        {
          "command": "opencode.addModel",
          "when": "false"
        },
        {
          "command": "opencode.deleteModel",
          "when": "false"
        },
        {
          "command": "opencode.openModelsFile",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "opencode.showPresetQuickPick",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      }
    ],
    "configuration": {
      "title": "OpenCode 配置管理器",
      "properties": {
        "opencodeConfigManager.configDirOverride": {
          "type": "string",
          "title": "配置目录覆盖",
          "description": "配置目录覆盖（默认自动发现 ~/.config/opencode，尊重 XDG_CONFIG_HOME）"
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node esbuild.mjs --tests && node test/e2e/run.mjs",
    "build:webview": "npm --prefix webview-ui run build",
    "package": "npm run compile && npm run build:webview && node -e \"require('node:fs').cpSync('webview-ui/build','dist-webview',{recursive:true})\" && vsce package --no-dependencies --allow-missing-repository --out build/packages"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.100.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
