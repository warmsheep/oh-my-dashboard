{
  "name": "opencode-config-manager",
  "displayName": "OpenCode 配置管理器",
  "description": "管理 opencode / oh-my-opencode 配置：结构化修改、备份、恢复、命名模板一键切换",
  "version": "0.24.0",
  "publisher": "local",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "opencodeConfig",
          "title": "OpenCode 配置",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "opencodeConfig": [
        {
          "id": "opencodeExplorer",
          "name": "OpenCode 配置"
        }
      ]
    },
    "commands": [
      {
        "command": "opencode.openConfigFile",
        "title": "打开配置",
        "category": "OpenCode"
      },
      {
        "command": "opencode.createConfig",
        "title": "创建缺失的配置",
        "category": "OpenCode"
      },
      {
        "command": "opencode.setAgentModel",
        "title": "设置 Agent/分类模型",
        "category": "OpenCode"
      },
      {
        "command": "opencode.capturePreset",
        "title": "从当前配置捕获模板",
        "category": "OpenCode",
        "icon": "$(add)"
      },
      {
        "command": "opencode.applyPreset",
        "title": "应用模板",
        "category": "OpenCode",
        "icon": "$(play)"
      },
      {
        "command": "opencode.editPreset",
        "title": "编辑模板（矩阵表单）",
        "category": "OpenCode",
        "icon": "$(edit)"
      },
      {
        "command": "opencode.renamePreset",
        "title": "重命名模板",
        "category": "OpenCode"
      },
      {
        "command": "opencode.deletePreset",
        "title": "删除模板",
        "category": "OpenCode"
      },
      {
        "command": "opencode.exportPreset",
        "title": "导出模板到文件",
        "category": "OpenCode"
      },
      {
        "command": "opencode.showPresetQuickPick",
        "title": "切换模板…",
        "category": "OpenCode"
      },
      {
        "command": "opencode.backupNow",
        "title": "立即备份",
        "category": "OpenCode",
        "icon": "$(save)"
      },
      {
        "command": "opencode.restoreBackup",
        "title": "恢复备份",
        "category": "OpenCode"
      },
      {
        "command": "opencode.diffBackup",
        "title": "与当前配置对比",
        "category": "OpenCode"
      },
      {
        "command": "opencode.deleteBackup",
        "title": "删除备份",
        "category": "OpenCode"
      },
      {
        "command": "opencode.exportBackup",
        "title": "导出备份（zip）",
        "category": "OpenCode"
      },
      {
        "command": "opencode.importBackup",
        "title": "导入备份（zip）…",
        "category": "OpenCode",
        "icon": "$(desktop-download)"
      },
      {
        "command": "opencode.refreshTree",
        "title": "刷新",
        "category": "OpenCode",
        "icon": "$(refresh)"
      },
      {
        "command": "opencode.addModel",
        "title": "添加模型…",
        "category": "OpenCode",
        "icon": "$(add)"
      },
      {
        "command": "opencode.deleteModel",
        "title": "删除模型",
        "category": "OpenCode"
      },
      {
        "command": "opencode.openModelsFile",
        "title": "打开模型清单文件",
        "category": "OpenCode",
        "icon": "$(go-to-file)"
      },
      {
        "command": "opencode.quotaRefresh",
        "title": "Coding Plan 额度：查看额度面板"
      },
      {
        "command": "opencode.quotaConfigureMimo",
        "title": "Coding Plan 额度：配置 MiMo Cookie"
      },
      {
        "command": "opencode.renameBackup",
        "title": "重命名备份"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "opencode.refreshTree",
          "when": "view == opencodeExplorer",
          "group": "navigation@99"
        }
      ],
      "view/item/context": [
        {
          "command": "opencode.applyPreset",
          "when": "view == opencodeExplorer && viewItem == preset",
          "group": "inline@1"
        },
        {
          "command": "opencode.editPreset",
          "when": "view == opencodeExplorer && viewItem == preset",
          "group": "inline@2"
        },
        {
          "command": "opencode.renamePreset",
          "when": "view == opencodeExplorer && viewItem == preset"
        },
        {
          "command": "opencode.deletePreset",
          "when": "view == opencodeExplorer && viewItem == preset"
        },
        {
          "command": "opencode.exportPreset",
          "when": "view == opencodeExplorer && viewItem == preset"
        },
        {
          "command": "opencode.restoreBackup",
          "when": "view == opencodeExplorer && viewItem == backup"
        },
        {
          "command": "opencode.renameBackup",
          "when": "view == opencodeExplorer && viewItem == backup",
          "group": "-"
        },
        {
          "command": "opencode.diffBackup",
          "when": "view == opencodeExplorer && viewItem == backup"
        },
        {
          "command": "opencode.exportBackup",
          "when": "view == opencodeExplorer && viewItem == backup"
        },
        {
          "command": "opencode.deleteBackup",
          "when": "view == opencodeExplorer && viewItem == backup"
        },
        {
          "command": "opencode.setAgentModel",
          "when": "view == opencodeExplorer && viewItem =~ /agent|category/"
        },
        {
          "command": "opencode.deleteModel",
          "when": "view == opencodeExplorer && viewItem == modelLocal"
        },
        {
          "command": "opencode.openModelsFile",
          "when": "view == opencodeExplorer && viewItem == modelRoot",
          "group": "inline@2"
        },
        {
          "command": "opencode.addModel",
          "when": "view == opencodeExplorer && viewItem == modelRoot",
          "group": "inline@1"
        },
        {
          "command": "opencode.backupNow",
          "when": "view == opencodeExplorer && viewItem == backupRoot",
          "group": "inline@1"
        },
        {
          "command": "opencode.importBackup",
          "when": "view == opencodeExplorer && viewItem == backupRoot",
          "group": "inline@2"
        },
        {
          "command": "opencode.capturePreset",
          "when": "view == opencodeExplorer && viewItem == presetRoot",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "opencode.openConfigFile",
          "when": "false"
        },
        {
          "command": "opencode.setAgentModel",
          "when": "false"
        },
        {
          "command": "opencode.applyPreset",
          "when": "false"
        },
        {
          "command": "opencode.editPreset",
          "when": "false"
        },
        {
          "command": "opencode.renamePreset",
          "when": "false"
        },
        {
          "command": "opencode.deletePreset",
          "when": "false"
        },
        {
          "command": "opencode.exportPreset",
          "when": "false"
        },
        {
          "command": "opencode.restoreBackup",
          "when": "false"
        },
        {
          "command": "opencode.diffBackup",
          "when": "false"
        },
        {
          "command": "opencode.deleteBackup",
          "when": "false"
        },
        {
          "command": "opencode.exportBackup",
          "when": "false"
        },
        {
          "command": "opencode.addModel",
          "when": "false"
        },
        {
          "command": "opencode.deleteModel",
          "when": "false"
        },
        {
          "command": "opencode.openModelsFile",
          "when": "false"
        },
        {
          "command": "opencode.renameBackup",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "opencode.showPresetQuickPick",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      }
    ],
    "configuration": {
      "title": "OpenCode 配置管理器",
      "properties": {
        "opencodeConfigManager.configDirOverride": {
          "type": "string",
          "title": "配置目录覆盖",
          "description": "配置目录覆盖（默认与 opencode 运行时一致：OPENCODE_CONFIG_DIR > XDG_CONFIG_HOME/opencode > ~/.config/opencode）"
        },
        "opencodeConfigManager.quota.refreshSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "description": "状态栏 Coding Plan 额度自动刷新间隔（秒，0 = 关闭自动刷新）"
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm --prefix webview-ui test",
    "test:watch": "vitest",
    "test:e2e": "node esbuild.mjs --tests && node test/e2e/run.mjs",
    "build:webview": "npm --prefix webview-ui run build",
    "package": "npm run compile && npm run build:webview && node -e \"require('node:fs').cpSync('webview-ui/build','dist-webview',{recursive:true})\" && vsce package --no-dependencies --allow-missing-repository --out build/packages"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.100.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.0",
    "prettier": "3.9.6",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
